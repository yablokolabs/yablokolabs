[Unit]
Description=Restate server (Polaris durable execution backend)
After=network-online.target

[Service]
WorkingDirectory=/home/azureuser/yablokolabs
# Real node binary, not a shebang shim: systemd's PATH does not include Hermes' node.
ExecStart=/home/azureuser/.hermes/node/bin/node /home/azureuser/.local/lib/node_modules/@restatedev/restate-server/lib/index.js
Environment=PATH=/home/azureuser/.hermes/node/bin:/home/azureuser/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
