[Unit]
Description=Polaris Restate services (lead discovery + outreach)
After=network-online.target restate-server.service
Requires=restate-server.service

[Service]
WorkingDirectory=/home/azureuser/yablokolabs/yablokolabs/polaris-restate
# .env is loaded by the app itself (dotenv) — systemd never reads it.
ExecStart=/home/azureuser/.hermes/node/bin/node /home/azureuser/yablokolabs/yablokolabs/polaris-restate/node_modules/tsx/dist/cli.mjs src/index.ts
Environment=PATH=/home/azureuser/.hermes/node/bin:/home/azureuser/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
