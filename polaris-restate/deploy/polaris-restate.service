[Unit]
Description=Polaris Restate services (lead discovery + outreach)
After=network-online.target restate-server.service
Requires=restate-server.service

[Service]
WorkingDirectory=%h/yablokolabs/polaris-restate
EnvironmentFile=%h/yablokolabs/polaris-restate/.env
ExecStart=%h/yablokolabs/polaris-restate/node_modules/.bin/tsx src/index.ts
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
